{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/CPRC-Vehicle",
  "definitions": {
    "CPRC-Vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "$ref": "./components/id.json"
        },
        "flags": {
          "$ref": "./components/flags.json"
        },
        "img": {
          "$ref": "./components/img.json"
        },
        "name": {
          "$ref": "./components/name.json"
        },
        "type": {
          "type": "string",
          "const": "vehicle"
        },
        "system": {
          "$ref": "#/definitions/System"
        }
      },
      "required": [
        "_id",
        "img",
        "name",
        "system",
        "type"
      ]
    },
    "System": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concealable": {
          "$ref": "./components/physical/concealable.json"
        },
        "description": {
          "$ref": "./components/common/description.json"
        },
        "favorite": {
          "$ref": "./components/common/favorite.json"
        },
        "installedItems": {
          "$ref": "./components/container/installedItems.json"
        },
        "isUpgraded": {
          "$ref": "./components/upgradable/isUpgraded.json"
        },
        "price": {
          "$ref": "./components/valuable/price.json"
        },
        "sdp": {
          "type": "integer"
        },
        "seats": {
          "type": "integer"
        },
        "source": {
          "$ref": "./components/common/source.json"
        },
        "speedCombat": {
          "type": "integer"
        },
        "speedNarrative": {
          "type": "string"
        },
        "upgrades": {
          "$ref": "./components/upgradable/upgrades.json"
        }
      },
      "required": [
        "concealable",
        "description",
        "favorite",
        "installedItems",
        "isUpgraded",
        "price",
        "sdp",
        "seats",
        "source",
        "speedCombat",
        "speedNarrative",
        "upgrades"
      ]
    }
  }
}

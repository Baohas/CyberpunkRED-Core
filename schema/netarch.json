{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_key": {
      "$ref": "./components/key.json"
    },
    "_id": {
      "$ref": "./components/id.json"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "netarch"
    },
    "img": {
      "$ref": "./components/img.json"
    },
    "system": {
      "type": "object",
      "allOf": [
        {
          "$ref": "./components/common.json"
        },
        {
          "$ref": "./components/valuable.json"
        }
      ],
      "properties": {
        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "standard",
            "uncommon",
            "advanced"
          ]
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string",
                "enum": [
                  "password",
                  "file",
                  "controlNode",
                  "program",
                  "blackIce",
                  "demon",
                  "root"
                ]
              },
              "dv": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "depth": {
                "type": "integer",
                "minimum": 1
              },
              "revealed": {
                "type": "boolean"
              },
              "dvRevealed": {
                "type": "boolean"
              },
              "programUuid": {
                "type": "string"
              },
              "iceName": {
                "type": "string"
              },
              "fileContentUuid": {
                "type": "string"
              },
              "controlNodeDeviceUuids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "virusPlanted": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "dv",
              "branch",
              "depth",
              "revealed",
              "dvRevealed",
              "controlNodeDeviceUuids",
              "virusPlanted"
            ]
          }
        }
      },
      "required": [
        "floors"
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "./components/effect.json"
      }
    },
    "folder": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort": {
      "type": "integer"
    },
    "ownership": {
      "type": "object"
    },
    "flags": {
      "type": "object"
    },
    "_stats": {
      "$ref": "./components/stats.json"
    }
  },
  "required": [
    "_id",
    "_key",
    "effects",
    "flags",
    "folder",
    "name",
    "ownership",
    "sort",
    "system",
    "type"
  ]
}

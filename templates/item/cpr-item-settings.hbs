{{cprTrace "START ITEM CPR-ITEM-SETTINGS.HBS"}}
<div class="item-settings-tab">
    <div class="item-settings-section">
        <div class="tab item-settings-grid" data-group="primary" data-tab="item-settings">
            <ol class="items-list">
                {{!-- Item Name --}}
                {{> "systems/cyberpunk-red-core/templates/item/cpr-item-name.hbs" this}}

                {{!-- Settings common to all items --}}
                <li class="item flexrow">
                    <div class="item flexrow setting-name text-nowrap">
                        {{localize "CPR.itemSheet.common.source"}}
                    </div>
                    <div class="item flexrow setting-value text-nowrap item-end">
                        {{#if this.editable}}
                        <input name="system.source" class="" type="text" value="{{item.system.source}}"
                            placeholder="Example: pg. 1">
                        {{else}}
                        <span>{{item.system.source}}</span>
                        {{/if}}
                    </div>
                </li>
                <hr>

                {{!-- Settings from mixins --}}
                {{#each (cprGetTemplates item.type) as |mixin|}}
                  {{#if (cprCompare mixin "!==" "effects")}}
                    {{!-- If it is the attackable mixin and this is either an itemUpgrade or cyberware, let those item types handle if
                      the mixin should be displayed or not since they may or may not be attackable --}}
                    {{#unless (cprCompare (cprCompare mixin "===" "attackable") "&&" (cprCompare (cprCompare ../item.type "===" "itemUpgrade") "||" (cprCompare ../item.type "===" "cyberware")))}}
                      {{> (cprGeneratePartial "systems/cyberpunk-red-core/templates/item/settings/mixin/cpr-VAR.hbs" mixin) ../this}}
                    {{/unless}}
                  {{/if}}
                {{/each}}

                {{!-- Settings specific to the item type --}}
                {{> (cprGeneratePartial "systems/cyberpunk-red-core/templates/item/settings/cpr-VAR.hbs" item.type) this}}

                {{!-- Settings specific to allowing items to be installed other items --}}
                <hr>
                <li class="item flexrow">
                  <div class="item flexrow setting-name text-nowrap">
                    {{localize "CPR.itemSheet.common.installedItemsAllowed"}}
                  </div>
                  <div class="item flexrow setting-value text-nowrap item-end">
                      {{#if this.editable}}
                          {{#if item.system.installedItems.allowed}}
                              <a class="item-checkbox" data-target="system.installedItems.allowed"><i class="far fa-check-circle"></i></a>
                          {{else}}
                              <a class="item-checkbox" data-target="system.installedItems.allowed"><i class="far fa-circle"></i></a>
                          {{/if}}
                      {{else}}
                          {{#if item.system.installedItems.allowed}}
                              <i class="far fa-check-circle"></i>
                          {{else}}
                              <i class="far fa-circle"></i>
                          {{/if}}
                      {{/if}}
                  </div>
                </li>
                {{#if item.system.installedItems.allowed}}
                  <div class="text-left text-padding-left">
                    <b><a class="manage-installable-types">{{localize "CPR.itemSheet.common.installedItemTypesAllowed"}}<i class="text-smallest text-super fas fa-wrench"></i></a></b>
                    {{#each item.system.installedItems.allowedTypes as |type| }}
                    <li>{{localize (cprFindConfigValue "objectTypes" type)}}</li>
                    {{/each}}
                  </div>
                {{/if}}
                {{#if (cprCompare (cprCompare item.system.installedItems.list.length ">" 0) "&&" item.actor)}}
                <hr>
                  <div class="text-left text-padding-left">
                    <b>{{localize "CPR.itemSheet.common.installedItems"}}</b>
                    {{#each item.system.installedItems.list as |UUID| }}
                    <li>{{cprGetProp (cprGetOwnedItem ../item.actor UUID) "name"}}</li>
                    {{/each}}
                  </div>
                {{/if}}
          </ol>
        </div>
    </div>
</div>
{{cprTrace "END CPR-ITEM-SETTINGS.HBS"}}

{{cprTrace "START ACTOR PARTS RIGHT-PANE CYBERWARE CPR-CYBERWARE-OPTIONAL-CONTENT.HBS"}}
<li class="item flexrow" data-item-id="{{cyberware._id}}" data-installation-id="{{cyberware.system.installedIn}}" draggable="false">
    <div class="item-name cyberware-name flexrow text-nowrap">
      <span>
        <a class="name item-view"><span class="name">{{#cprLoop depth}}&nbsp;{{/cprLoop}}{{cyberware.name}}</span>{{#if cyberware.system.isUpgraded}}<sup><i class="fab fa-uniregistry"></sup></i>{{/if}}</a>
        {{#if (cprCompare cyberware.system.installedItems.slots ">" 0)}}
          ({{cyberware.system.installedItems.usedSlots}}/{{cyberware.system.installedItems.slots}} {{localize "CPR.characterSheet.rightPane.cyber.usedSlots"}})
        {{/if}}
      </span>
    </div>
    <div class="item-detail cyberware-data text-nowrap">
        {{localize (cprFindConfigValue "cyberwareTypeList" cyberware.system.type)}}
    </div>
    <div class="item-detail cyberware-actions text-nowrap">
        {{!-- INSTALL ACTION --}}
        {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-uninstall-glyph.hbs" cyberware}}
        {{!-- ITEM MANAGEMENT --}}
        {{#if isUpgraded}}
          {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-upgrade-glyph.hbs"}}
        {{else}}
          {{#unless (cprIsEmpty (cprFilter (cprFilter actor.itemTypes.itemUpgrade "type" "cyberware") "system.isInstalled" false))}}
            {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-upgrade-glyph.hbs"}}
          {{/unless}}
        {{/if}}
    </div>
</li>
{{#each cyberware.system.installedItems.list as |UUID|}}
  {{> "systems/cyberpunk-red-core/templates/actor/parts/right-pane/parts/cyberware/cpr-cyberware-optional-content.hbs" (cprMergeForPartialArg "actor,cyberware,depth" ../actor (cprGetOwnedItem ../actor UUID) (cprMath "sum" ../depth 1))}}
{{/each}}
{{cprTrace "END ACTOR PARTS RIGHT-PANE CYBERWARE CPR-CYBERWARE-OPTIONAL-CONTENT.HBS"}}

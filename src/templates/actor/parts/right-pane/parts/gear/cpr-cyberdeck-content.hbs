{{cprTrace "START ACTOR PARTS RIGHT-PANE PARTS GEAR CPR-CYBERDECK-CONTENT.HBS"}}
{{log "START ACTOR PARTS RIGHT-PANE PARTS GEAR CPR-CYBERDECK-CONTENT.HBS"}}
{{log this}}
<li class="item flexrow{{#if item.system.favorite}} favorite{{else}}{{#if (cprListContains sheet.options.collapsedSections "gearTab-gear")}} hide{{/if}}{{/if}}" data-item-id="{{item._id}}"
    data-item-category="{{item.type}}" draggable="true">
    <div class="item-name gear-name text-nowrap">
        <a class="name item-edit" title="{{item.name}}&#13{{localize "CPR.characterSheet.bottomPane.fight.clickToViewTheItem"}}&#13{{localize "CPR.characterSheet.bottomPane.fight.controlClickToSendToChat"}}">{{item.name}}{{#if item.system.isUpgraded}}<sup><i class="fab fa-uniregistry"></i></sup>{{/if}}</a>
        {{#if item.system.isInstalled}}
          <a class="item-view" data-item-id="{{item.system.installedIn}}"><span title="{{localize "CPR.characterSheet.rightPane.cyber.installedIn"}} {{cprGetProp (cprGetOwnedItem actor item.system.installedIn) "name"}}"><sup><i class="fa-solid fa-circle-info"></i></sup></span></a>
        {{/if}}
    </div>
    <div class="item-detail gear-data text-nowrap">
        {{localize "CPR.global.generic.slots"}}: {{cprApplyUpgrade item item.system.installedItems.slots "slots"}} | {{localize "CPR.global.generic.price"}}: {{item.system.price.market}}
    </div>
    <div class="item-detail gear-actions text-nowrap">
        {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-actions.hbs" item}}
    </div>
</li>
{{cprTrace "END CPR-CYBERDECK-CONTENT.HBS"}}

{{cprTrace "START ACTOR PARTS RIGHT-PANE CYBERWARE CPR-CYBERWARE-FOUNDATIONAL-CONTENT.HBS"}}
{{#if cyberware.system.core}}
  {{#each cyberware.system.installedItems.list as |UUID|}}
    {{> "systems/cyberpunk-red-core/templates/actor/parts/right-pane/parts/cyberware/cpr-cyberware-optional-content.hbs" (cprMergeForPartialArg "actor,cyberware,depth" ../actor (cprGetOwnedItem ../actor UUID) 0)}}
  {{/each}}
{{else}}
  <li class="item flexrow" data-item-id="{{cyberware._id}}" draggable="false">
      <div class="item-name cyberware-name text-nowrap">
          <a class="name item-view">{{cyberware.name}} ({{cyberware.system.installedItems.usedSlots}}/{{cprApplyUpgrade cyberware cyberware.system.installedItems.slots "slots"}} {{localize "CPR.itemSheet.cyberware.optionalSlots"}}){{#if cyberware.system.isUpgraded}}<sup><i class="text-super fa-solid fa-square-up"></i></sup>{{/if}}</a>
      </div>
      <div class="item-detail cyberware-data text-nowrap">
          {{localize (cprFindConfigValue "cyberwareTypeList" cyberware.system.type)}}
      </div>
      <div class="item-detail cyberware-actions text-nowrap">
          {{#unless (cprListContains "fashionware,cyberwareInternal,cyberwareExternal" cyberware.system.type)}}
          {{!-- INSTALL ACTION --}}
          {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-uninstall-glyph.hbs" cyberware}}
          {{!-- ITEM MANAGEMENT --}}
          {{#if isUpgraded}}
            {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-upgrade-glyph.hbs"}}
          {{else}}
            {{#unless (cprIsEmpty (cprFilter (cprFilter actor.itemTypes.itemUpgrade "type" "cyberware") "system.isInstalled" false))}}
              {{> "systems/cyberpunk-red-core/templates/actor/parts/common/actions/cpr-upgrade-glyph.hbs"}}
            {{/unless}}
          {{/if}}
          {{/unless}}
      </div>
  </li>
  {{#each cyberware.system.installedItems.list as |UUID|}}
    {{> "systems/cyberpunk-red-core/templates/actor/parts/right-pane/parts/cyberware/cpr-cyberware-optional-content.hbs" (cprMergeForPartialArg "actor,cyberware,depth" ../actor (cprGetOwnedItem ../actor UUID) 1)}}
  {{/each}}
{{/if}}

{{cprTrace "END ACTOR PARTS RIGHT-PANE CYBERWARE CPR-CYBERWARE-FOUNDATIONAL-CONTENT.HBS"}}

{{!-- Partials to create stat-units from template --}}
{{#each displayedStats as |stat| }}
  <div class="mook-{{stat.key}}-stat">
    <div>
      <a class="rollable"
         data-roll-type="stat"
         data-roll-title="{{stat.key}}"
         data-tooltip="{{localize CPR.clicktorollthisstat}}">
        {{localize (cprFindConfigValue "statList" stat.key)}}
      </a>
    </div>
    <div class="block-data text-normal">
      {{#if (cprCompare stat.key "!==" "luck") }}
        <input name="system.stats.{{stat.key}}.value" type="number" value="{{stat.value}}"/>
      {{else}}
        <input name="dash" type="text" readonly value="-"/>
      {{/if}}
    </div>
  </div>
{{/each}}

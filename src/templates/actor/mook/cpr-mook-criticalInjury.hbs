{{cprTrace "START ACTOR MOOK CPR-MOOK-CRITICALINJURY.HBS"}}
<div class="items-header bg-red fg-white flexrow">
  <span class="item-name section-name text-nowrap text-padding-left-smallest">
    {{localize "CPR.mookSheet.criticalInjuries"}}
    <a class="roll-critical-injury"
       data-tooltip="{{localize "CPR.mookSheet.criticalInjuryRoll"}}"
       data-item-type="criticalInjury">
      <i class="fas fa-dice text-padding-right-smallest"></i>
    </a>
  </span>
</div>
<div class="bg-white fg-black text-padding-left-smallest mook-crit-list">
  {{#each actor.itemTypes.criticalInjury as |item i| }}
    <a class="name item-edit deletable changeable {{#if item.system.deathSaveIncrease }}text-bold{{/if }}" data-tooltip="{{localize "CPR.mookSheet.items.clickToViewItem" }}
      <br/>
      {{localize "CPR.mookSheet.items.ctrlClickToSendToChat"}}
      <br/>
      {{localize "CPR.mookSheet.items.pressDeleteToDelete"}}" tabindex="0" data-item-id="{{item.id}}">
      {{#if (cprCompare item.system.location "===" "body") }}
        <i class="fas fa-user-injured text-padding-left-smallest"></i>
      {{/if}}
      {{#if (cprCompare item.system.location "===" "head") }}
        <i class="fa-regular fa-face-head-bandage"></i>
      {{/if}}
      {{item.name}}
      {{#unless @last}},{{/unless}}
    </a>
  {{/each}}
</div>
{{cprTrace "END CPR-MOOK-CRITICALINJURY.HBS"}}

                       data-item-id="{{weapon.id}}">
                      {{#if (cprFireMode ../actor "autofire" weapon.id) }}
                        <i class="far fa-check-circle"></i>
                      {{else}}
                        <i class="far fa-circle"></i>
                      {{/if}}
                    </a>
                  </div>
                  <div class="mook-weapon-supp text-center">
                    <a class="fire-checkbox"
                       data-fire-mode="suppressive"
                       data-item-id="{{weapon.id}}">
                      {{#if (cprFireMode ../actor "suppressive" weapon.id) }}
                        <i class="far fa-check-circle"></i>
                      {{else}}
                        <i class="far fa-circle"></i>
                      {{/if}}
                    </a>
                  </div>
                {{/if}}
              </div>
              <div class="mook-weapon-rolls fight-weapon-attack text-nowrap text-right">
                <a class="rollable" data-roll-type="attack" data-item-id="{{weapon.id}}">
                  <i class="fas fa-fist-raised red-fg"
                     data-tooltip="{{localize "CPR.characterSheet.bottomPane.fight.rollAnAttack"}}"></i>
                </a>
                {{#if (cprCompare (cprFireFlag ../actor "suppressive" weapon.id) "!==" "checked") }}
                  <a class="rollable damage-roll-{{weapon.id}}" data-roll-type="damage" data-item-id="{{weapon.id}}" data-damage="{{weapon.system.damage}}">
                    <i class="fas fa-tint red-fg"
                       data-tooltip="{{localize "CPR.actorSheets.commonActions.rollDamage"}}"></i>
                  </a>
                {{/if}}
              </div>
            </div>
          </li>
        {{/if}}
        <!-- Support Weapon Upgrades on the Mook Sheet -->
        {{#if weapon.system.isUpgraded }}
          {{#each weapon.system.upgrades as |upgrade| }}
            {{#if upgrade.system.modifiers.secondaryWeapon.configured}}
              {{#each (cprFilter ../actor.itemTypes.itemUpgrade "_id" upgrade._id) as |weapon| }}
                <li class="item flexrow">
                  <div class="mook-weapon">
                    <div class="item-name mook-weapon-name text-pad-right text-nowrap">
                      <a class="name item-edit deletable changeable" tabindex="0" data-item-id="{{weapon.id}}" data-tooltip="{{localize "CPR.mookSheet.items.clickToViewItem"}}
                        <br/>
                        {{localize "CPR.mookSheet.items.ctrlClickToSendToChat"}}
                        <br/>
                        {{localize "CPR.mookSheet.items.pressDeleteToDelete"}}">
                        {{weapon.name}}
                      </a>
                      <br/>
                      {{#if weapon.system.isRanged }}
                        {{#if weapon.system.magazine.ammoData.uuid }}
                          ({{localize "CPR.global.itemTypes.ammo"}}: {{weapon.system.magazine.value}}/{{weapon.system.magazine.max}})
                        {{else}}
                          ({{localize "CPR.mookSheet.items.unloaded"}})
                        {{/if}}
                        {{> "systems/cyberpunk-red-core/templates/actor/mixin/actions/cpr-reload-glyph.hbs"}}
                        {{>"systems/cyberpunk-red-core/templates/actor/mixin/actions/cpr-dv-glyph.hbs"}}
                      {{else}}
                        ({{localize "CPR.global.itemType.skill.meleeWeapon"}})
                      {{/if}}
                    </div>
                    <div class="mook-weapon-mode">
                      <div class="mook-weapon-aim text-center">
                        <a class="fire-checkbox"

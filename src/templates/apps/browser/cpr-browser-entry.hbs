<li
  class="cpr-browser-entry cpr-browser-entry-{{rowParity}} {{#if groupCollapsed}}cpr-browser-hidden{{/if}}"
  data-uuid="{{uuid}}" data-doc-class="{{docClass}}" data-group="{{type}}"
  draggable="{{draggable}}">
  <span class="cpr-browser-entry-open" data-action="openDocument" role="button"
    tabindex="0">
    <span class="cpr-browser-entry-thumb">
      <img class="cpr-browser-entry-img" src="{{img}}" alt="{{name}}" />
      {{#if hasInstalled}}
      <i class="fa-solid fa-square-caret-up fa-xs cpr-browser-entry-upgraded"
        data-tooltip="{{localize 'CPR.global.generic.upgraded'}}"></i>
      {{/if}}
    </span>
    <span class="cpr-browser-entry-body">
      <span class="cpr-browser-entry-top">
        <span class="cpr-browser-entry-name"
          {{#if description}}data-tooltip="{{description}}"
          data-tooltip-direction="RIGHT"{{/if}}>{{name}}</span>
        {{#if hasPrice}}
        <span class="cpr-browser-entry-price">
          <span class="cpr-browser-entry-eb">{{priceLabel}}</span>
          {{#if priceCategoryLabel}}
          <span class="cpr-browser-entry-category">({{localize priceCategoryLabel}})</span>
          {{/if}}
        </span>
        {{/if}}
      </span>
      <span class="cpr-browser-entry-mid">
        <span class="cpr-browser-entry-breadcrumb">{{breadcrumb}}</span>
        {{#if sourceLine}}
        <span class="cpr-browser-entry-source">{{sourceLine}}</span>
        {{/if}}
      </span>
      <span class="cpr-browser-entry-chips">
        {{#each chips}}
        <span class="cpr-browser-chip">{{this}}</span>
        {{/each}}
      </span>
    </span>
  </span>
  <span class="cpr-browser-entry-actions">
    {{#if hasInstalled}}
    <a class="cpr-browser-expand" data-action="toggleInstalled" role="button"
      tabindex="0" data-tooltip="{{localize 'CPR.global.generic.installedItems'}}">
      <i class="fa-solid fa-chevron-up fa-sm fa-flip-vertical"></i>
    </a>
    {{/if}}
    {{#if canBuy}}
    <a class="cpr-browser-buy" data-action="addToCart" role="button" tabindex="0"
      data-tooltip="{{localize 'CPR.browser.cart.add'}}">
      <i class="fa-solid fa-cart-plus"></i>
    </a>
    {{/if}}
  </span>
</li>

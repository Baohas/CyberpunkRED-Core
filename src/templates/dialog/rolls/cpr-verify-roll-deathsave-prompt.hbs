{{cprTrace "START DIALOG ROLLS CPR-VERIFY-ROLL-DEATHSAVE-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.rollingFor"}} "{{rollData.rollTitle}}", Choomba!
    </div>
    <ol class="items-list">
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.global.generic.deathPenalty"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="penalty" class="" type="number" data-dtype="Number" value={{rollData.penalty}}>
            </div>
        </li>

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.characterSheet.rightPanke.skills.base"}} {{localize "CPR.global.generic.deathPenalty"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="basePenalty" class="" type="number" data-dtype="Number" value={{rollData.basePenalty}}>
            </div>
        </li>

        {{!-- All applied modifier list partial --}}
        {{> "systems/cyberpunk-red-core/templates/dialog/rolls/cpr-all-modifiers.hbs" this}}
    </ol>

    {{!-- Situational modifier list partial --}}
    {{#if (cprCompare filteredMods.length ">" 0)}}
      {{> "systems/cyberpunk-red-core/templates/dialog/rolls/cpr-situational-modifiers.hbs" this}}
    {{/if}}

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}

</form>
{{cprTrace "END CPR-VERIFY-ROLL-DEATHSAVE-PROMPT.HBS"}}

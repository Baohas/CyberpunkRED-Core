{{#if (cprCompare filteredMods.length ">" 0)}}
<hr>
<ol class="items-list">
  {{#each filteredMods as |mod|}}
  <li class="item flexrow" style="border-style: outset; border-color: rgba(110, 42, 42, 0.5); border-width: 2px; border-radius: 5px; margin: 2px 0px 2px 0px;
      {{#if (cprObjectListContains ../rollData.mods "id" mod.id)}}background-color: lightgrey;{{/if}}">
    <div class="item flexrow setting-name text-nowrap text-bold">
        {{mod.source}} -
    </div>
    <div class="item flexrow setting-value text-nowrap">
      {{cprGetChangeNameByKey false mod.category mod.key}}
      {{cprEffectModMode mod.changeMode mod.value}}:
    </div>
    <div class="item flexrow setting-value text-nowrap item-end">
      {{#if (cprObjectListContains ../rollData.mods "id" mod.id)}}
          <a class="toggle-situational-mod" data-mod-id="{{mod.id}}"><i class="far fa-check-circle"></i></a>
      {{else}}
          <a class="toggle-situational-mod" data-mod-id="{{mod.id}}"><i class="far fa-circle"></i></a>
      {{/if}}
    </div>
  </li>
  {{/each}}
</ol>
{{/if}}

<hr>
<div style="text-align:center;"><a class="toggle-default-mods">
  {{#if showDefaultMods}}
    {{localize "CPR.rolls.defaultMods.situationalHide"}} <i class="fas fa-square-caret-down"></i>
  {{else}}
    {{localize "CPR.rolls.defaultMods.situationalShow"}} <i class="fas fa-square-caret-right"></i>
  {{/if}}
</a></div>
{{#if showDefaultMods}}
<ol id="default-mods" class="items-list">
  {{#each defaultSituationalMods as |mod|}}
  <li class="item flexrow" style="border-style: outset; border-color: rgba(110, 42, 42, 0.5); border-width: 2px; border-radius: 5px; margin: 2px 0px 2px 0px;
      {{#if (cprObjectListContains ../rollData.mods "id" mod.id)}}background-color: lightgrey;{{/if}}">
    <div class="item flexrow setting-name text-nowrap text-bold">
        {{localize mod.source}}:
    </div>
    <div class="item flexrow setting-value text-nowrap">
      {{#if (cprCompare mod.value ">" 0)}}+{{/if}}{{mod.value}}
    </div>
    <div class="item flexrow setting-value text-nowrap item-end">
      {{#if (cprObjectListContains ../rollData.mods "id" mod.id)}}
          <a class="toggle-situational-mod" data-mod-id="{{mod.id}}"><i class="far fa-check-circle"></i></a>
      {{else}}
          <a class="toggle-situational-mod" data-mod-id="{{mod.id}}"><i class="far fa-circle"></i></a>
      {{/if}}
    </div>
  </li>
  {{/each}}
  <br>
</ol>
{{/if}}
<hr>

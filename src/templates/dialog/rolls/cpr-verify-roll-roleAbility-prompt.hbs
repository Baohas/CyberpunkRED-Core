{{cprTrace "START DIALOG ROLLS CPR-VERIFY-ROLL-ROLEABILITY-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.rollingFor"}} {{rollData.roleName}}, Choomba!
    </div>

    <ol class="items-list">
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.abilityRank"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="roleValue" class="" type="number" data-dtype="Number" value={{rollData.roleValue}}>
            </div>
        </li>

        {{#if rollData.statValue}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
              {{localize "CPR.global.generic.stat"}} - {{localize (cprFindConfigValue "statList" rollData.statName)}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="statValue" class="" type="number" data-dtype="Number" value={{rollData.statValue}}>
            </div>
        </li>
        {{/if}}

        {{#if (cprCompare rollData.skillName "!==" "--")}}
        {{#if isVarying}}
        <li class="item flexrow">
          <div class="item flexrow setting-name text-nowrap">
            {{localize "CPR.itemSheet.role.chooseSkill"}}
          </div>
          <div class="item flexrow setting-value text-nowrap item-end">
            <select class="skill-list-select" name = "skillName">
              {{#each (cprSortCoreSkills rollData.skillList) as |skill|}}
                <option value = "{{skill.name}}" {{#if (cprCompare ../rollData.skillName "===" skill.name)}} selected {{/if}}>{{localize (cprGetLocalizedlNameKey skill.name "skill")}}</option>
              {{/each}}
            </select>
          </div>
        </li>
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.global.generic.skill"}} - {{#if (cprCompare rollData.skillName "===" "varying")}}{{localize "CPR.global.generic.varying"}}{{else}}{{rollData.skillName}}{{/if}}
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="dummySkillValue" class="" type="number" data-dtype="Number" value={{rollData.skillValue}} {{#if (cprCompare rollData.skillName "===" "varying")}}disabled{{/if}}>
            </div>
        </li>
        {{else}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.global.generic.skill"}} - {{localize (cprGetLocalizedlNameKey rollData.skillName "skill")}}
{{!--                 {{#if (cprCompare roleName "===" "operator")}} {{localize "CPR.trading"}}:{{/if}}
                {{#if (cprCompare roleName "===" "medtechPharma")}} {{localize "CPR.medicaltechcryooperation"}}:{{/if}}
                {{#if (cprCompare roleName "===" "medtechCryo")}} {{localize "CPR.medicaltechpharmaceuticals"}}:{{/if}} --}}
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="skillValue" class="" type="number" data-dtype="Number" value={{rollData.skillValue}}>
            </div>
        </li>
        {{/if}}
        {{/if}}

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.mods"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end" data-tooltip="
                {{#each rollData.mods}}
                  {{this.source}} {{~#if this.key}}&nbsp;({{localize (cprFindConfigValue "activeEffectKeys" this.category this.key)}}){{~/if}}: {{this.value}}
                  <br>
                {{/each}}
              ">
              <input disabled name="mods" class="" type="text" data-dtype="String" value="{{#each rollData.mods}}{{this.value}}{{#unless @last}}, {{/unless}}{{/each}}">
            </div>
        </li>

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.luck"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="luck" class="" type="number" data-dtype="Number" value={{rollData.luck}}>
            </div>
        </li>

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.shouldRollCriticals"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="calculateCritical" class="" type="checkbox" data-dtype="Checkbox" checked>
            </div>
        </li>
    </ol>

    {{#if (cprCompare filteredMods.length ">" 0)}}
    <hr>
    <ol class="items-list">
      {{#each filteredMods as |mod|}}
      <li class="item flexrow">
        <div class="item flexrow setting-name text-nowrap text-bold">
            {{mod.source}}:
        </div>
        <div class="item flexrow setting-value text-nowrap">
          {{localize (cprFindConfigValue "activeEffectKeys" mod.category mod.key)}}
          {{cprEffectModMode mod.changeMode mod.value}}
        </div>
        <div class="item flexrow setting-value text-nowrap item-end">
          <input {{checked (cprObjectListContains ../rollData.mods "id" mod.id)}} class="active-effect-checkbox" type="checkbox" data-mod-id="{{mod.id}}" data-dtype="Checkbox">
        </div>
      </li>
      {{/each}}
      <br>
    </ol>
    {{/if}}

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}


</form>
{{cprTrace "END CPR-VERIFY-ROLL-ROLEABILITY-PROMPT.HBS"}}

{{cprTrace "START DIALOG ROLLS CPR-VERIFY-ROLL-DAMAGE-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.tellThemToSayHello"}}! {{localize "CPR.rolls.roll"}} {{localize "CPR.global.generic.damage"}} {{localize "CPR.global.generic.with"}} "{{rollData.rollTitle}}", Choomba!
    </div>
    <ol class="items-list">
        {{#if (cprCompare (cprListContains "assaultRifle,smg,heavySmg" rollData.weaponType) "||" rollData.isAutofire)}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.global.skills.autofire"}}?
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input type="checkbox" id="isAutofire" name="isAutofire" {{#if rollData.isAutofire}} checked{{/if}}>
            </div>
        </li>
        {{#if rollData.isAutofire}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.global.generic.multiplier"}}
                {{#if (cprCompare rollData.autofireMultiplierMax ">" 0)}}
                    (1-{{rollData.autofireMultiplierMax}}):
                  {{else}}
                    {{#if (cprListContains "assaultRifle,smg,heavySmg" rollData.weaponType)}}
                      (1-{{#if (cprCompare rollData.weaponType "===" "assaultRifle")}}4{{else}}3{{/if}}):
                    {{else}}
                      ({{localize "CPR.rolls.noAutfireMaxConfig"}})
                    {{/if}}
                {{/if}}
            </div>
        <div class="item flexrow setting-value text-nowrap item-end">
            <input type="number" class="number" name="autofireMultiplier" data-dtype="Number" value=1
                max="{{#if (cprCompare rollData.weaponType "===" "assaultRifle")}}4{{else}}3{{/if}}" min="1">
        </div>
        {{/if}}
        {{/if}}

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.aimedShot"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">

                <input name="isAimed" class="aimed-checkbox" type="checkbox" data-dtype="Checkbox"{{#if rollData.isAimed}} checked{{/if}}>
            </div>
        </li>

        {{#if rollData.isAimed}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.aimFor"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <select name="location">
                    {{!-- ONLY DISPLAY CYBERWARE OF SAME TYPE AS OPTIONAL --}}
                    {{#each (cprFindConfigObj "aimedLocation") as |loc l|}}
                    <option value="{{l}}" {{#if  (cprCompare ../rollData.location "===" l)}}selected{{/if}}>{{localize loc}}</option>
                    {{/each}}
                </select>
            </div>
        </li>
        {{/if}}

        {{#if rollData.universalBonusDamage}}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.universalBonuses.damage"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="universalBonusDamage" class="" type="number" data-dtype="Number" value={{rollData.universalBonusDamage}}>
            </div>
        </li>
        {{/if}}


        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.mods"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="mods" class="" type="text" data-dtype="String" value="{{rollData.mods}}">
            </div>
        </li>
    </ol>

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}

</form>
{{cprTrace "END CPR-VERIFY-ROLL-DAMAGE-PROMPT.HBS"}}

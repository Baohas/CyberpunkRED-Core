{{cprTrace "START DIALOG ROLLS CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.roll"}} {{localize "CPR.rolls.damageFor"}} "{{rollData.rollCardExtraArgs.program.name}} ({{localize (cprFindConfigValue "programClassList" rollData.rollCardExtraArgs.pgmClass)}})", Choomba!
    </div>
    <ol class="items-list">
      {{#if (cprCompare (cprCompare rollData.rollCardExtraArgs.pgmClass "===" "antiprogramattacker") "&&" (cprCompare rollData.rollCardExtraArgs.program.system.damage.blackIce "!==" "")) }}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.selectTarget"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
              <select name="formula">
                {{#select rollData.formula}}
                <option value="{{rollData.rollCardExtraArgs.pgmDamage.standard}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.itemSheet.program.nonBlackIce"}} ({{rollData.rollCardExtraArgs.pgmDamage.standard}})</option>
                <option value="{{rollData.rollCardExtraArgs.pgmDamage.blackIce}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.global.programClass.blackice"}} ({{rollData.rollCardExtraArgs.pgmDamage.blackIce}})</option>
                {{/select}}
              </select>
            </div>
        </li>
        {{/if}}
         <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.mods"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
                <input name="mods" class="" type="text" data-dtype="String" value={{rollData.mods}}>
            </div>
        </li>
    </ol>

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}

</form>
{{cprTrace "END CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}

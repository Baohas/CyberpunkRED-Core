{{cprTrace "START DIALOG ROLLS CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.roll"}} {{localize "CPR.rolls.damageFor"}}
        {{#if rollData.rollCardExtraArgs.program.name}}
          "{{rollData.rollCardExtraArgs.program.name}} ({{localize (cprFindConfigValue "programClassList" rollData.rollCardExtraArgs.program.class)}})", Choomba!
        {{else if (cprCompare rollCardExtraArgs.program.class "===" "blackice")}}
          "{{localize "CPR.global.programClass.blackice"}}"
        {{else}}
          "{{localize "CPR.global.role.netrunner.interfaceAbility.zap"}}"
        {{/if}}
    </div>
    <ol class="items-list">
      {{#if (cprCompare (cprCompare rollData.rollCardExtraArgs.program.class "===" "antiprogramattacker") "&&" (cprCompare rollData.rollCardExtraArgs.program.damage.blackIce "!==" "")) }}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.selectTarget"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
              <select name="formula">
                {{#select rollData.formula}}
                <option value="{{rollData.rollCardExtraArgs.program.damage.standard}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.itemSheet.program.nonBlackIce"}} ({{rollData.rollCardExtraArgs.program.damage.standard}})</option>
                <option value="{{rollData.rollCardExtraArgs.program.damage.blackIce}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.global.programClass.blackice"}} ({{rollData.rollCardExtraArgs.program.damage.blackIce}})</option>
                {{/select}}
              </select>
            </div>
        </li>
        {{/if}}

        {{!-- All applied modifier list partial --}}
        {{> "systems/cyberpunk-red-core/templates/dialog/rolls/cpr-all-modifiers.hbs" this}}
    </ol>

    {{!-- Situational modifier list partial --}}
      {{> "systems/cyberpunk-red-core/templates/dialog/rolls/cpr-situational-modifiers.hbs" this}}

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}

</form>
{{cprTrace "END CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}

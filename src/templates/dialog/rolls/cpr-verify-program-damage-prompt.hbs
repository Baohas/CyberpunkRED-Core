{{cprTrace "START DIALOG ROLLS CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}
<form>
    <div>
        {{localize "CPR.rolls.roll"}} {{localize "CPR.rolls.damageFor"}}
        {{#if rollData.rollCardExtraArgs.program.name}}
          "{{rollData.rollCardExtraArgs.program.name}} ({{localize (cprFindConfigValue "programClassList" rollData.rollCardExtraArgs.pgmClass)}})", Choomba!
        {{else if (cprCompare rollCardExtraArgs.pgmClass "===" "blackice")}}
          "{{localize "CPR.global.programClass.blackice"}}"
        {{else}}
          "{{localize "CPR.global.role.netrunner.interfaceAbility.zap"}}"
        {{/if}}
    </div>
    <ol class="items-list">
      {{#if (cprCompare (cprCompare rollData.rollCardExtraArgs.pgmClass "===" "antiprogramattacker") "&&" (cprCompare rollData.rollCardExtraArgs.pgmDamage.blackIce "!==" "")) }}
        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.selectTarget"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end">
              <select name="formula">
                {{#select rollData.formula}}
                <option value="{{rollData.rollCardExtraArgs.pgmDamage.standard}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.itemSheet.program.nonBlackIce"}} ({{rollData.rollCardExtraArgs.pgmDamage.standard}})</option>
                <option value="{{rollData.rollCardExtraArgs.pgmDamage.blackIce}}">{{localize "CPR.itemSheet.program.damageTo"}} {{localize "CPR.global.programClass.blackice"}} ({{rollData.rollCardExtraArgs.pgmDamage.blackIce}})</option>
                {{/select}}
              </select>
            </div>
        </li>
        {{/if}}

        <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
                {{localize "CPR.rolls.mods"}}:
            </div>
            <div class="item flexrow setting-value text-nowrap item-end" data-tooltip="
                {{#each rollData.mods}}
                  {{this.source}} {{~#if this.key}}&nbsp;({{localize (cprFindConfigValue "activeEffectKeys" this.category this.key)}}){{~/if}}: {{this.value}}
                  <br>
                {{/each}}
              ">
              <input disabled name="mods" class="" type="text" data-dtype="String" value="{{#each rollData.mods}}{{this.value}}{{#unless @last}}, {{/unless}}{{/each}}">
            </div>
        </li>
    </ol>

  {{> "systems/cyberpunk-red-core/templates/dialog/cpr-dialog-buttons.hbs"}}

</form>
{{cprTrace "END CPR-VERIFY-PROGRAM-DAMAGE-PROMPT.HBS"}}

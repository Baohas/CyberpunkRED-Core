{{cprTrace "START DIALOG ROLLS CPR-ALL-MODIFIERS.HBS"}}
<li class="dialog-item total-mods flexrow">
  <div class="dialog-item-name text-nowrap">
    {{localize "CPR.rolls.modifiers.modsTotal"}}:
  </div>
  <div class="dialog-item-input text-bold text-nowrap dialog-item-end"
    {{#if (cprCompare rollData.mods.length "||" rollData.additionalMods.length)}}
      data-tooltip="
        {{#each rollData.mods as |mod|}}
          {{localize mod.source}} {{~#if mod.key}}&nbsp;({{cprGetChangeNameByKey false mod.category mod.key}}){{~/if}}: {{numberFormat mod.value sign=true}}
          <br>
        {{/each}}
        {{#if rollData.additionalMods}}
          {{localize "CPR.rolls.modifiers.additionalMods"}}:{{#each rollData.additionalMods as |mod|}}&nbsp;{{numberFormat mod sign=true}}{{#unless @last}},{{/unless}}{{/each}}
        {{/if}}
      ">
    {{/if}}
    <span class="text-padding-right">{{numberFormat totalMods sign=true}}</span>
  </div>
</li>
{{cprTrace "END CPR-ALL-MODIFIERS.HBS"}}

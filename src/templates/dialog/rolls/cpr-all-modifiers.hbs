<li class="item flexrow">
    <div class="item flexrow setting-name text-nowrap">
        {{localize "CPR.rolls.mods"}}:
    </div>
    <div class="item flexrow setting-value text-nowrap item-end" data-tooltip="
        {{#each rollData.mods}}
          {{localize this.source}} {{~#if this.key}}&nbsp;({{cprGetChangeNameByKey false this.category this.key}}){{~/if}}: {{this.value}}
          <br>
        {{/each}}
          {{#if rollData.additionalMods}} {{localize "CPR.rolls.modifiers.additionalMods"}}: {{rollData.additionalMods}} {{/if}}
      ">
      <input disabled name="mods" class="" type="text" data-dtype="String" value="{{#each rollData.mods}}{{this.value}}{{#unless @last}}, {{/unless}}{{/each}}">
    </div>
</li>

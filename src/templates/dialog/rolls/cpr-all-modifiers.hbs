<li class="item flexrow">
    <div class="item flexrow setting-name text-nowrap">
        {{localize "CPR.rolls.mods"}}:
    </div>
    <div class="item flexrow setting-value text-nowrap item-end" {{#if (cprCompare rollData.mods.length "||" rollData.additionalMods.length)}} data-tooltip="
        {{#each rollData.mods as |mod|}}
          {{localize mod.source}} {{~#if mod.key}}&nbsp;({{cprGetChangeNameByKey false mod.category mod.key}}){{~/if}}: {{numberFormat mod.value sign=true}}
          <br>
        {{/each}}
          {{#if rollData.additionalMods}}
            {{localize "CPR.rolls.modifiers.additionalMods"}}:{{#each rollData.additionalMods as |mod|}}&nbsp;{{numberFormat mod sign=true}}{{#unless @last}},{{/unless}}{{/each}}
          {{/if}}
      ">{{/if}}
      <input disabled name="mods" class="" type="text" data-dtype="String" value="{{#each rollData.mods as |mod|}}{{numberFormat mod.value sign=true}}{{#unless @last}}, {{/unless}}{{/each}}">
    </div>
</li>

{{cprTrace "START DIALOG CPR-SELECT-ITEM-UPGRADE-PROMPT.HBS"}}
<form>
  {{localize "CPR.dialog.selectItemUpgrades.selectItemUpgrades"}} "{{item.name}}", Choomba!
  <ol class="items-list">
    {{!-- Display Available Slots --}}
    <li class="item flexrow">
      <div class="item flexrow">
        <span class="text-bold">
          {{localize "CPR.itemSheet.itemUpgrade.slots"}}: {{item.system.upgrades.length}}/{{item.system.slots}}
        </span>
      </div>
    </li>
    <hr>
    {{!-- Item Upgrades Header Bar--}}
    <li class="item flexrow">
      <div class="item flexrow item-name">
        <span class="text-bold text-left">
          {{localize "CPR.itemSheet.common.itemUpgrades"}}
        </span>
      </div>
      <div style="max-width: 60px" class="item flexrow item-detail">
        <span class="text-bold text-right" >
          {{localize "CPR.global.generic.slots"}}
        </span>
      </div>
      <div style="max-width: 60px" class="item flexrow item-detail">
        <span class="text-bold text-align-last-end text-space-around" >
          {{localize "CPR.dialog.common.select"}}
        </span>
      </div>
    </li>

    {{!-- Item Upgrade Selection --}}
    {{#each this.availableUpgrades as |upgrade|}}
    <li class="item flexrow">
      <div class="item flexrow text-nowrap item-name">
        <span class="width-full" style="text-overflow: ellipsis; overflow: hidden">
          {{upgrade.name}}
        </span>
      </div>
      <div style="max-width: 60px" class="item flexrow item-detail text-right">
        <span>
          {{upgrade.system.size}}
        </span>
      </div>
      <div style="max-width: 60px" class="item flexrow item-detail text-bold text-align-last-end text-space-around">
        <span >
          {{#if upgrade.system.isInstalled}}
            <input type="checkbox" name="selectedUpgrade" value="{{upgrade._id}}" checked>
          {{else}}
            <input type="checkbox" name="selectedUpgrade" value="{{upgrade._id}}">
          {{/if}}
        </span>
      </div>
    </li>
    {{/each}}
  <br>
  </ol>
</form>
{{cprTrace "END CPR-SELECT-ITEM-UPGRADE-PROMPT.HBS"}}

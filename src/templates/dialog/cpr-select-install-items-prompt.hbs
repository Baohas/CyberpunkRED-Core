{{cprTrace "START DIALOG CPR-SELECT-INSTALL-ITEMS-PROMPT.HBS"}}
<form>
  {{text}}, Choomba!
  <ol class="items-list">
    {{#each this.typeList as |itemType|}}
        <li class="item flexrow">
      <div class="item flexrow setting-name">
        <span class="text-bold text-nowrap">{{localize (cprFindConfigValue "objectTypes" itemType)}}</span>
      </div>
      <div class="item flexrow setting-value">
        <span class="text-bold text-nowrap text-align-last-end text-space-around">{{localize "CPR.dialog.common.select"}}</span>
      </div>
    </li>
      {{#each ../this.itemsList as |item|}}
        {{#if (cprCompare item.type "===" itemType)}}
          <li class="item flexrow">
            <div class="item flexrow setting-name text-nowrap">
              {{item.name}} {{#if (cprCompare item.type "===" "program")}}({{localize (cprFindConfigValue "programClassList" item.system.class)}}){{/if}}
            </div>
            <div class="item flexrow setting-value text-nowrap text-space-around">
              {{#if item.system.isInstalled}}
              <span class="text-bold text-nowrap text-align-last-end text-space-around"><input type="checkbox" name="selectedItems" value="{{item._id}}" checked></span>
              {{else}}
              <span class="text-bold text-nowrap text-align-last-end text-space-around"><input type="checkbox" name="selectedItems" value="{{item._id}}"></span>
              {{/if}}
            </div>
          </li>
        {{/if}}
      {{/each}}
    {{/each}}

  </ol>
</form>
{{cprTrace "END DIALOG CPR-SELECT-INSTALL-ITEMS-PROMPT.HBS"}}

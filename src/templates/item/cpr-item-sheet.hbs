<div class="item-sheet">
  <div class="item-top-pane">

    <div class="item-header-top">
      <div class="item-image item-image-block">
        <img src="{{item.img}}" class="item-image-block-img" data-edit="img" />
        {{#if item.system.isUpgraded }}
          <i class="fa-solid fa-square-caret-up fa-xs" data-tooltip="{{localize "CPR.global.generic.upgraded"}}"></i>
        {{/if}}
        {{#if item.system.isInstalled }}
          <i class="fa-solid fa-circle-info fa-xs" data-tooltip="{{localize "CPR.global.generic.installed"}}"></i>
        {{/if}}
      </div>

      <div class="item-header-top-details">
        <div class="item-header-row item-header-row-top">
          <div class="item-header-breadcrumb">
            {{#each breadcrumb}}
              {{#unless @first}}<span class="item-header-breadcrumb-sep">/</span>{{/unless}}
              {{#if @first}}
                <a class="item-header-breadcrumb-segment item-header-type-link"
                   href="{{cprWikiLink ../item.type}}"
                   data-tooltip="{{localize "CPR.global.generic.helparticle"}}"
                   style="opacity:{{this.opacity}}">{{this.label}}</a>
              {{else}}
                <span class="item-header-breadcrumb-segment"
                      style="opacity:{{this.opacity}}">{{this.label}}</span>
              {{/if}}
            {{/each}}
          </div>
          {{#if (cprHasTemplate item.type "valuable") }}
            <div class="item-header-price">
              <span class="item-header-price-value">{{cprNumberFormat item.system.price.market}}eb</span>
              <span class="item-header-price-category">
                ({{localize
                    (cprFindConfigValue "itemPriceCategory"
                      (cprGetPriceCategory item.system.price.market)
                )}})
              </span>
            </div>
          {{/if}}
        </div>

        <div class="item-header-name text-large text-hero">
          <span class="item-header-name-text">
            {{localize (cprGetLocalizedlNameKey item)}}
          </span>
          {{#if (cprIsDebug) }}
            <span class="item-header-debug text-small">({{item.id}})</span>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="item-header-divider"></div>

    <div class="item-header-row item-header-row-bottom">
      <div class="item-header-chips">
        {{#each chips}}
          <span class="cpr-browser-chip">{{this}}</span>
        {{/each}}
      </div>
      <div class="item-header-sources">
        {{sourceCitation}}
      </div>
    </div>
  </div>

  <div class="item-bottom-pane">
    <div class="item-bottom-tabs-section">
      <nav class="navtabs-item cpr-tabs nav text-semi" data-group="primary">
        <div class="tab-pink-underlay">
          <a class="tab-label text-small tab-indent" data-tab="item-description">
            {{localize "CPR.global.generic.description"}}
          </a>
        </div>
        <div class="tab-pink-underlay">
          <a class="tab-label text-small tab-indent" data-tab="item-settings">
            {{localize "CPR.settings.title"}}
          </a>
        </div>
        {{#if (cprHasTemplate item.type "effects") }}
          <div class="tab-pink-underlay">
            <a class="tab-label text-small tab-indent" data-tab="item-effects">
              {{localize "CPR.itemSheet.effects.effects"}}
            </a>
          </div>
        {{/if}}
      </nav>
    </div>
    <div class="item-bottom-content-section">
      <div class="tab item-description-grid"
           data-group="primary"
           data-tab="item-description">
        {{> "systems/cyberpunk-red-core/templates/item/cpr-item-description.hbs" this}}
      </div>
      <div class="tab item-settings-grid"
           data-group="primary"
           data-tab="item-settings">
        {{> "systems/cyberpunk-red-core/templates/item/cpr-item-settings.hbs" this}}
      </div>
      {{#if (cprHasTemplate item.type "effects") }}
        <div class="tab item-effects-grid"
             data-group="primary"
             data-tab="item-effects">
          {{> "systems/cyberpunk-red-core/templates/item/cpr-item-effects.hbs" this}}
        </div>
      {{/if}}
    </div>
  </div>

</div>

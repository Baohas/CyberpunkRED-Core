<div class="item-netarch-section">
  {{!-- Difficulty Rating (sets node DVs) --}}
  <li class="item flexrow">
    <div class="item flexrow setting-name text-nowrap">
      {{localize "CPR.netArchitecture.difficulty"}}
    </div>
    <div class="item flexrow setting-value text-nowrap item-end">
      <select name="system.difficulty" data-dtype="{{item.system.difficulty}}">
        {{selectOptions (cprFindConfigObj "netArchDifficulty") selected=item.system.difficulty localize=true}}
      </select>
    </div>
  </li>
  {{#if this.isGM}}
    <li class="item flexrow netarch-roll-level">
      <a class="netarch-generate-button">
        <i class="fas fa-dice fa-sm"></i>
        {{localize "CPR.netArchitecture.generation.useRolltables"}}
      </a>
    </li>
  {{/if}}
  {{!-- Floors are authored/generated and run in the Netrunning App; shown read-only here. --}}
  <li class="items-header flexrow">
    <span class="item-name netarch-level text-nowrap text-padding-left">{{localize "CPR.netArchitecture.floor.shortWord"}}</span>
    <span class="item-name netarch-dv text-nowrap text-padding-left">{{localize "CPR.netArchitecture.floor.dv"}}</span>
    <span class="item-name netarch-content text-nowrap text-padding-left">{{localize "CPR.netArchitecture.floor.data"}}</span>
  </li>
  <div class="netarch-list-content">
    <ol class="items-list">
      {{#each (cprSort item.system.floors "depth") as |floor| }}
        <li class="item item-netarch-grid flexrow">
          <div class="netarch-level">{{floor.depth}}{{floor.branch}}</div>
          <div class="netarch-dv">{{#if floor.dv}}{{floor.dv}}{{/if}}</div>
          <div class="netarch-content">
            <div class="text-semi">{{localize (cprFindConfigValue "netArchFloorContent" floor.content)}}</div>
            {{#if floor.iceName}}<div class="text-semi">{{localize floor.iceName}}</div>{{/if}}
            {{#if floor.description}}<div>{{floor.description}}</div>{{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
  </div>
</div>

<div class="text-normal text-bold text-nowrap" data-tooltip="
  {{#each mods}}
    {{localize this.source}} {{#if this.key}}({{cprGetChangeNameByKey false this.category this.key}}){{/if}}: {{this.value}}
    <br>
  {{/each}}
  {{#if additionalMods}} {{localize "CPR.rolls.modifiers.additionalMods"}}: {{additionalMods}} {{/if}}
">
  {{localize "CPR.rolls.modifiers.modsTotal"}}: {{totalMods}}
</div>
